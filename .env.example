AI_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=your-anthropic-model-name

MONGODB_URI=mongodb+srv://username:password@cluster-url/sharepass?retryWrites=true&w=majority
MONGODB_DB=sharepass
MONGODB_COLLECTION_POSTS=posts
MONGODB_COLLECTION_CIRCLES=circles
MONGODB_COLLECTION_USERS=users
MONGODB_COLLECTION_FEEDBACK=feedback

NEXT_PUBLIC_SUPER_ADMIN_EMAILS=admin@example.com
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id
